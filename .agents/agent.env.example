# Optional local role assignment for mac-llm agent workflow.
# Copy to .agents/agent.env if you want repo-local defaults.

# Highest-reasoning coordinator. Plans with the human, creates PRDs/issues when asked,
# assigns work, monitors high-level progress, and handles escalations/takeover.
AGENT_SUPERVISOR=claude

# Implementation harness/provider that watches issues assigned to it and manages
# its own issue-worker subagents. Issues must have: agent:ready + worker:<AGENT_IMPLEMENTOR>
AGENT_IMPLEMENTOR=claude

# Legacy alias. Prefer AGENT_IMPLEMENTOR in new configs.
# AGENT_IMPLEMENTER=claude

# PR reviewer provider used by scripts/agent/review-loop.sh.
# Built-ins: codex, claude, cursor
AGENT_REVIEWER=codex

AGENT_BASE_BRANCH=main
AGENT_WATCH_POLL_SECONDS=300
AGENT_MAX_ACTIVE_WORKERS=2
AGENT_MAX_REVIEW_LOOPS=3
AGENT_MAX_AMBIGUOUS_REVIEWS=1
REVIEW_POLL_SECONDS=45

# Optional override if a reviewer uses a custom GitHub identity.
# REVIEWER_AUTHOR_REGEX='codex|openai'

# Optional override if using a custom reviewer provider/template.
# REVIEWER_REQUEST_TEMPLATE='.agents/reviewers/custom-request.md'
# REVIEWER_LABEL='review:custom'

# If 1, implementors first check worker:<AGENT_IMPLEMENTOR>, then worker:any.
# If 0, implementors only claim their explicit worker:<AGENT_IMPLEMENTOR> queue.
AGENT_ALLOW_WORKER_ANY=1
